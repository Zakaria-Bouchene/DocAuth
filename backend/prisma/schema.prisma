generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  Int                   @id @default(autoincrement())
  name                String
  email               String                @unique
  password            String
  role                String                // 'DOCTOR' | 'ADMIN'
  documents           Document[]
  verificationResults VerificationResult?
}

model Document {
  id             Int             @id @default(autoincrement())
  userId         Int
  type           String          // 'ID_CARD' | 'MEDICAL_LICENSE' | 'DIPLOMA'
  fileUrl        String
  user           User            @relation(fields: [userId], references: [id])
  extractedData  ExtractedData?
}

model ExtractedData {
  id             Int       @id @default(autoincrement())
  documentId     Int       @unique
  jsonData       String    // Storing JSON string for SQLite compatibility
  document       Document  @relation(fields: [documentId], references: [id])
}

model VerificationResult {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  licenseValid   Boolean
  anomalies      String    // Array of risk flags as JSON string
  score          Int
  status         String    // 'APPROVED' | 'PENDING' | 'REJECTED'
  user           User      @relation(fields: [userId], references: [id])
}
