generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  Int                   @id @default(autoincrement())
  name                String
  email               String                @unique
  password            String
  role                String                // 'DOCTOR' | 'ADMIN'
  phone               String?
  dateOfBirth         String?
  nationalId          String?
  profileStatus       String                @default("incomplete") // incomplete | pending | verified | rejected
  trustScore          Int                   @default(0)
  verificationStatus  String                @default("pending")    // verified | pending | review_required | rejected
  
  // Professional Details
  specialty           String?               
  licenseNumber       String?               
  institution         String?               
  graduationYear      String?               
  country             String?               
  degreeType          String?               // General | Specialist
  practiceType        String?               // Public | Private
  wilaya              String?

  documents           Document[]
  verificationResults VerificationResult?
  auditLogs           AuditLog[]
  verificationLogs    VerificationLog[]
}

model Document {
  id                 Int             @id @default(autoincrement())
  userId             Int
  type               String          // ID_CARD, DEGREE, REGISTRATION, DSP, SELFIE, etc.
  fileUrl            String
  verificationStatus String          @default("pending")
  anomalyFlags       String?         // JSON string
  version            Int             @default(1)
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id])
  extractedData      ExtractedData?
}

model ExtractedData {
  id             Int       @id @default(autoincrement())
  documentId     Int       @unique
  jsonData       String    // Storing JSON string for SQLite compatibility
  document       Document  @relation(fields: [documentId], references: [id])
}

model VerificationResult {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  licenseValid   Boolean
  anomalies      String    // Array of risk flags as JSON string
  score          Int
  status         String    // 'APPROVED' | 'PENDING' | 'REJECTED'
  annotations    String?   // JSON string for visual annotations (rectangles, notes)
  forensicData   String?   // JSON string for AI forensic analysis results
  user           User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  userId    Int?
  action    String   // e.g. 'UPLOAD', 'ADMIN_APPROVE', 'LOGIN', 'BLOCKCHAIN_ANCHOR'
  details   String?  // JSON string for additional details
  txHash    String?  // Optional blockchain transaction hash
  user      User?    @relation(fields: [userId], references: [id])
}

model VerificationLog {
  id             Int      @id @default(autoincrement())
  userId         Int
  checkType      String   // OCR, FACE_MATCH, CROSS_VAL, etc.
  result         String   // PASS | FAIL | WARNING
  details        String?  // JSON string
  timestamp      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}
