generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  Int                   @id @default(autoincrement())
  name                String
  email               String                @unique
  password            String
  role                String                // 'DOCTOR' | 'ADMIN'
  phone               String?
  specialty           String?               // Self-declared specialty (e.g., 'Cardiology')
  licenseNumber       String?               // Self-declared license number for cross-referencing
  institution         String?               // Hospital or clinic name
  graduationYear      String?               // Year of graduation
  country             String?               // Country of practice
  documents           Document[]
  verificationResults VerificationResult?
  auditLogs           AuditLog[]
}

model Document {
  id             Int             @id @default(autoincrement())
  userId         Int
  type           String          // 'ID_CARD' | 'MEDICAL_LICENSE' | 'DIPLOMA'
  fileUrl        String
  user           User            @relation(fields: [userId], references: [id])
  extractedData  ExtractedData?
}

model ExtractedData {
  id             Int       @id @default(autoincrement())
  documentId     Int       @unique
  jsonData       String    // Storing JSON string for SQLite compatibility
  document       Document  @relation(fields: [documentId], references: [id])
}

model VerificationResult {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  licenseValid   Boolean
  anomalies      String    // Array of risk flags as JSON string
  score          Int
  status         String    // 'APPROVED' | 'PENDING' | 'REJECTED'
  annotations    String?   // JSON string for visual annotations (rectangles, notes)
  user           User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  userId    Int?
  action    String   // e.g. 'UPLOAD', 'ADMIN_APPROVE', 'LOGIN', 'BLOCKCHAIN_ANCHOR'
  details   String?  // JSON string for additional details
  txHash    String?  // Optional blockchain transaction hash
  user      User?    @relation(fields: [userId], references: [id])
}
